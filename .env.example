# Postgres local
DATABASE_URL=postgresql+psycopg://diario:diario@localhost:5432/diario_aberto

# Base do site da Imprensa Oficial — fica em config, não hardcoded no código
SCRAPER_BASE_URL=https://imprensaoficial.jundiai.sp.gov.br

# Educado com o servidor da prefeitura: identifica quem está fazendo a requisição
# e define o intervalo mínimo entre requisições (em segundos).
SCRAPER_USER_AGENT="diario-aberto-bot/0.1 (projeto pessoal de portfolio; contato: seu-email@exemplo.com)"
SCRAPER_DELAY_SECONDS=2.0